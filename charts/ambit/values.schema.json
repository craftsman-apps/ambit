{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "llm": {
      "type": "object",
      "properties": {
        "promptGuard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "enum": ["audit", "reject", "mask"] },
            "builtins": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["CreditCard", "Ssn", "Email", "PhoneNumber", "CaSin"] }
            },
            "patterns": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
            },
            "rejectMessage": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "webhook": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "service": { "type": "string", "maxLength": 253 },
                "namespace": { "type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "failureMode": { "enum": ["FailClosed", "FailOpen"] }
              }
            }
          }
        }
      }
    }
  }
}
