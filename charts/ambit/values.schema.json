{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "llm": {
      "type": "object",
      "properties": {
        "promptGuard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "enum": ["audit", "reject", "mask"] },
            "builtins": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["CreditCard", "Ssn", "Email", "PhoneNumber", "CaSin"] }
            },
            "patterns": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
            },
            "rejectMessage": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "webhook": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "service": { "type": "string", "pattern": "^$|^[a-z]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
                "namespace": { "type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "failureMode": { "enum": ["FailClosed", "FailOpen"] }
              }
            }
          }
        }
      }
    },
    "protection": {
      "type": "object",
      "properties": {
        "injectionGuard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "enum": ["audit", "reject", "mask"] },
            "builtins": { "type": "boolean" },
            "disabledBuiltins": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["ignore-previous-instructions", "disregard-instructions", "new-instructions", "reveal-system-prompt", "chatml-marker", "inst-marker", "role-prefix", "hide-from-user", "persona-override", "addressed-to-ai", "html-comment-instruction", "tag-characters", "zero-width-run"] }
            },
            "patterns": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
            },
            "webhook": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "service": { "type": "string", "pattern": "^$|^[a-z]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
                "namespace": { "type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "timeout": { "type": "string", "pattern": "^[0-9]{1,4}(\\.[0-9]{1,3})?(ms|s|m)$" },
                "failureMode": { "enum": ["FailClosed", "FailOpen"] }
              }
            }
          }
        }
      }
    }
  }
}
