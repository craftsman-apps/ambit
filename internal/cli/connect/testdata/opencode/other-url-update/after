{
  // my opencode setup
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": { "llama": { "name": "llama" } }, // trailing comma below
    },
    "ambit": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ambit",
      "options": {
        "baseURL": "https://llm.example.com/v1",
        "apiKey": "{env:AMBIT_API_KEY}"
      },
      "models": {
        "new/model": {
          "name": "new/model"
        }
      }
    },
  },
  "mcp": {},
  "model": "ambit/new/model",
}
