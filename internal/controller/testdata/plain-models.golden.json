[
  {
    "apiVersion": "agentgateway.dev/v1alpha1",
    "kind": "AgentgatewayModel",
    "metadata": {
      "labels": {
        "ambitproject.dev/model": "azure-gpt",
        "app.kubernetes.io/managed-by": "ambit"
      },
      "name": "azure-gpt",
      "namespace": "ambit-system",
      "ownerReferences": [
        {
          "apiVersion": "ambitproject.dev/v1alpha1",
          "blockOwnerDeletion": true,
          "controller": true,
          "kind": "Model",
          "name": "azure-gpt",
          "uid": "uid-azure-gpt"
        }
      ]
    },
    "spec": {
      "azure": {
        "apiVersion": "2025-01-01",
        "resourceName": "eu-west",
        "resourceType": "OpenAI"
      },
      "match": {
        "model": "gpt-5-deploy"
      },
      "parentRefs": [
        {
          "group": "gateway.networking.k8s.io",
          "kind": "HTTPRoute",
          "name": "ambit-llm"
        }
      ],
      "policies": {
        "auth": {
          "location": {
            "header": {
              "name": "api-key"
            }
          },
          "secretRef": {
            "name": "ambit-llm-openrouter"
          }
        },
        "authorization": {
          "action": "Allow",
          "policy": {
            "matchExpressions": [
              "(has(apiKey.keyId) ? apiKey.groups : (has(jwt.groups) ? jwt.groups : [])).exists(g, g in [\"eng\"])"
            ]
          }
        }
      },
      "provider": "Azure"
    }
  },
